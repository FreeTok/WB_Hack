@echo off
chcp 1251 > nul
REM Переключаем кодовую страницу консоли на Windows-1251 для поддержки кириллицы

REM Переходим в директорию, где находится сам батник
cd /d "%~dp0"

REM Проверяем наличие файла app.py
if not exist app.py (
    echo Ошибка: Файл app.py не найден в текущей директории.
    echo Убедитесь, что батник находится в той же папке, что и app.py
    pause
    exit /b 1
)

REM Запускаем Python-скрипт
echo Запуск приложения выбора папок...
python app.py

REM Если скрипт завершился с ошибкой
if %errorlevel% neq 0 (
    echo Приложение завершилось с ошибкой (код %errorlevel%).
    pause
)